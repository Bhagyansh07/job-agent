# Copy this file to .env and fill values. NEVER share .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google Sheet ID (the long id in the sheet URL). First tab must be named: Applications
GOOGLE_SHEET_ID=
# Apollo.io free API key (optional until ready). Plain Gmail account may be rejected; use work/college email.
APOLLO_API_KEY=
# Hunter.io API key (optional fallback for email finding)
HUNTER_API_KEY=
# 1 = never click final Submit; log with dry_ prefix
DRY_RUN=0
# Optional: per-cycle timeout for opencode run (seconds)
OPENCODE_CYCLE_TIMEOUT=1800
