{
  "$schema": "https://opencode.ai/config.json",
  "model": "kilo/laguna-s",
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "secrets/**": "deny",
      "browser-profiles/**": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "secrets/**": "deny",
      "browser-profiles/**": "deny"
    },
    "webfetch": "allow",
    "shell": {
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny",
      "format *": "deny",
      "shutdown *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny"
    }
  },
  "mcp": {
    "pw_chat1": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@0.0.83", "--browser", "chrome", "--user-data-dir", "./browser-profiles/chat1"],
      "enabled": true
    },
    "pw_chat2": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@0.0.83", "--browser", "chrome", "--user-data-dir", "./browser-profiles/chat2"],
      "enabled": true
    },
    "pw_chat3": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@0.0.83", "--browser", "chrome", "--user-data-dir", "./browser-profiles/chat3"],
      "enabled": true
    }
  }
}
